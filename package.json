{
  "name": "pebble-support",
  "displayName": "Pebble Template Support",
  "description": "Pebble Templates language support: highlighting, IntelliSense, diagnostics and navigation. Plays nicely with Datastar and HTMX.",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "publisher": "MarkusAugust",
  "author": {
    "name": "Markus August",
    "url": "https://github.com/MarkusAugust"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkusAugust/cobble"
  },
  "homepage": "https://github.com/MarkusAugust/cobble#readme",
  "bugs": {
    "url": "https://github.com/MarkusAugust/cobble/issues"
  },
  "icon": "pebbleInHtml.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "keywords": [
    "pebble",
    "peb",
    "template",
    "pebble-html",
    "html",
    "datastar",
    "htmx",
    "spring",
    "java",
    "syntax"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:pebble",
    "onLanguage:html"
  ],
  "main": "./dist/client.js",
  "contributes": {
    "languages": [
      {
        "id": "pebble",
        "aliases": [
          "Pebble",
          "pebble"
        ],
        "extensions": [
          ".peb",
          ".pebble"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pebble",
        "scopeName": "text.html.pebble",
        "path": "./syntaxes/pebble.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "injection.html.pebble",
        "path": "./syntaxes/pebble-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative",
          "text.html.pebble"
        ]
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/pebble.json"
      },
      {
        "language": "pebble",
        "path": "./snippets/pebble.json"
      }
    ]
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:prod": "bun scripts/build.ts --production",
    "watch": "bun scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "bun test test/unit",
    "test:grammar": "vscode-tmgrammar-snap --config test/grammar/config.json 'test/grammar/fixtures/**/*.{peb,html}'",
    "test:grammar:update": "vscode-tmgrammar-snap --config test/grammar/config.json --updateSnapshot 'test/grammar/fixtures/**/*.{peb,html}'",
    "check": "bun run lint && bun run typecheck && bun run test:unit && bun run test:grammar",
    "package": "bun run build:prod && vsce package --no-dependencies",
    "vscode:prepublish": "bun run check && bun run build:prod",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "vscode-html-languageservice": "^5.3.0",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
