{
  "name": "pebble-support",
  "displayName": "Pebble Template Support",
  "description": "Pebble Templates language support: highlighting, IntelliSense, diagnostics and navigation. Plays nicely with Datastar and HTMX.",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "publisher": "MarkusAugust",
  "author": {
    "name": "Markus August",
    "url": "https://github.com/MarkusAugust"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkusAugust/cobble"
  },
  "homepage": "https://github.com/MarkusAugust/cobble#readme",
  "bugs": {
    "url": "https://github.com/MarkusAugust/cobble/issues"
  },
  "icon": "pebbleInHtml.png",
  "engines": {
    "vscode": "^1.91.0"
  },
  "keywords": [
    "pebble",
    "peb",
    "template",
    "pebble-html",
    "html",
    "datastar",
    "htmx",
    "spring",
    "java",
    "syntax"
  ],
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:pebble",
    "onLanguage:html"
  ],
  "main": "./dist/client.js",
  "contributes": {
    "languages": [
      {
        "id": "pebble",
        "aliases": [
          "Pebble",
          "pebble"
        ],
        "extensions": [
          ".peb",
          ".pebble"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pebble",
        "scopeName": "text.html.pebble",
        "path": "./syntaxes/pebble.tmLanguage.json",
        "embeddedLanguages": {
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "scopeName": "injection.html.pebble",
        "path": "./syntaxes/pebble-injection.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative",
          "text.html.pebble"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.html": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/pebble.json"
      },
      {
        "language": "pebble",
        "path": "./snippets/pebble.json"
      }
    ],
    "configuration": {
      "title": "Pebble",
      "properties": {
        "pebble.templateRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "src/main/resources/templates",
            "src/main/resources",
            "templates",
            "resources/templates"
          ],
          "scope": "resource",
          "markdownDescription": "Directories, relative to each workspace folder, that template names in `extends`, `include`, `import`, `from` and `embed` are resolved against. The directory of the current file is always tried first."
        },
        "pebble.templateSuffixes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".peb",
            ".pebble",
            ".html"
          ],
          "scope": "resource",
          "markdownDescription": "Suffixes tried when a referenced template name has no extension (Spring Boot's default suffix is `.peb`)."
        },
        "pebble.customFilters": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Shown in completion and hover (Markdown)."
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parameter names, used for signature help and snippets."
              }
            }
          },
          "scope": "resource",
          "markdownDescription": "Filters provided by your own Pebble extensions. They get completion and hover, and are not reported as unknown."
        },
        "pebble.customFunctions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Shown in completion and hover (Markdown)."
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parameter names, used for signature help and snippets."
              }
            }
          },
          "scope": "resource",
          "markdownDescription": "Functions provided by your own Pebble extensions."
        },
        "pebble.customTests": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string",
                "description": "Shown in completion and hover (Markdown)."
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Parameter names, used for signature help and snippets."
              }
            }
          },
          "scope": "resource",
          "markdownDescription": "Tests (`is \u2026`) provided by your own Pebble extensions."
        },
        "pebble.customTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Tag names provided by your own Pebble extensions. Suppresses the unknown-tag error for them."
        },
        "pebble.spring.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Include the functions and variables of the Pebble Spring extension (`message`, `href`, `hasErrors`, \u2026, `request`, `session`, `beans`)."
        },
        "pebble.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report syntax and semantic problems in Pebble templates."
        },
        "pebble.diagnostics.unknownFilter": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "scope": "resource",
          "markdownDescription": "Severity for filters that are neither built in nor listed in `pebble.customFilters` (code W001)."
        },
        "pebble.diagnostics.unknownFunction": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "off",
          "scope": "resource",
          "markdownDescription": "Severity for functions that are neither built in, macros, nor listed in `pebble.customFunctions` (code W003)."
        },
        "pebble.diagnostics.unknownTest": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "scope": "resource",
          "markdownDescription": "Severity for tests that are neither built in nor listed in `pebble.customTests` (code W002)."
        },
        "pebble.diagnostics.missingTemplate": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "information",
            "off"
          ],
          "default": "warning",
          "scope": "resource",
          "markdownDescription": "Severity when a referenced template cannot be found in any template root (code W006)."
        },
        "pebble.html.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Provide Pebble IntelliSense and diagnostics inside `{{ }}` and `{% %}` in `.html` files. Requires a window reload to take effect."
        },
        "pebble.html.delegate": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "In `.peb`/`.pebble` files, provide HTML tag and attribute completion, hover, folding and symbols via the HTML language service."
        },
        "pebble.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Traces the communication between VS Code and the Pebble language server."
        }
      }
    },
    "commands": [
      {
        "command": "pebble.restartServer",
        "title": "Restart Language Server",
        "category": "Pebble"
      },
      {
        "command": "pebble.enableDatastarSupport",
        "title": "Enable Datastar support for Pebble files",
        "category": "Pebble"
      }
    ],
    "configurationDefaults": {
      "[pebble]": {
        "editor.snippetSuggestions": "top"
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:prod": "bun scripts/build.ts --production",
    "watch": "bun scripts/build.ts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:unit": "bun test test/unit",
    "test:grammar": "vscode-tmgrammar-test --config test/grammar/config.json 'test/grammar/spec/**/*.{peb,html}' && vscode-tmgrammar-snap --config test/grammar/config.json 'test/grammar/fixtures/**/*.{peb,html}'",
    "test:grammar:update": "vscode-tmgrammar-snap --config test/grammar/config.json --updateSnapshot 'test/grammar/fixtures/**/*.{peb,html}'",
    "check": "bun run lint && bun run typecheck && bun scripts/generate-grammar-names.ts --check && bun run test:unit && bun run test:grammar",
    "package": "bun run build:prod && vsce package --no-dependencies",
    "vscode:prepublish": "bun run check && bun run build:prod",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "generate:grammar": "bun scripts/generate-grammar-names.ts"
  },
  "dependencies": {
    "vscode-html-languageservice": "^5.3.0",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.3.0",
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
